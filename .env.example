# Firebase web config. Copy to .env and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# These are NOT secrets. They are compiled into the public JavaScript bundle and
# anyone can read them in DevTools. Google says so explicitly:
#   https://firebase.google.com/docs/projects/api-keys
# Your data is protected by firestore.rules, not by hiding these values.
#
# Leave them blank and the app still runs — it falls back to browser-only storage
# with no sign-in. Fill them in to turn on Google sign-in and cross-device sync.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only for GitHub Pages project sites, e.g. /acquisition-bench/
# VITE_BASE_PATH=/
